# Copy to backend/.env (backend reads .env from the backend/ directory).
# Never commit the real .env file.

NODE_ENV=development

# Port for the backend API. The frontend expects http://localhost:5000.
PORT=5000

# PostgreSQL started by the root docker-compose.yml (host port 5435).
DATABASE_URL=postgresql://whatsapp_user:whatsapp_password@localhost:5435/whatsapp_intelligence?schema=public

# Groq AI provider. Use YOUR OWN key from https://console.groq.com/keys
# GROQ_MODEL is any chat model id your Groq account can use.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Human review: messages with AI confidence below this (0-1), HIGH priority,
# or category INCIDENT are held for review. Required; no default.
AI_REVIEW_CONFIDENCE_THRESHOLD=0.80

# WhatsApp (WPPConnect) session storage. Local only, git-ignored, created
# automatically on first run. Scan the QR in the app to populate it.
WHATSAPP_SESSION_PATH=./tokens
# WPPConnect session name (optional; this is the default).
WHATSAPP_CLIENT_ID=whatsapp-message-intelligence
# true = Chromium runs hidden (recommended). Use the app's QR UI to log in.
WHATSAPP_HEADLESS=true
