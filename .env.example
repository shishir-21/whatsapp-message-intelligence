# Copy this file to .env and fill in real values locally.
# Never commit real secrets.

NODE_ENV=development

# Groq AI provider. GROQ_MODEL is any chat model id your Groq account can use.
GROQ_API_KEY=
GROQ_MODEL=

# Human review: messages with AI confidence below this (0-1), HIGH priority,
# or category INCIDENT are held for review. Required; no default.
AI_REVIEW_CONFIDENCE_THRESHOLD=0.80
